# Telegram Bot Token (от @BotFather)
TELEGRAM_BOT_TOKEN=your-bot-token-here

# OpenAI API (или совместимый шлюз)
OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1

# Pinecone
PINECONE_API_KEY=pcsk_your-api-key-here
PINECONE_INDEX_NAME=your-index-name

# Опционально
OPENAI_CHAT_MODEL=gpt-4o-mini
PINECONE_ENVIRONMENT=us-east-1

# Порог сходства для памяти (0-1)
# MEMORY_COSINE_SIMILARITY_HIGH_THRESHOLD=0.8

# Связность диалога: сколько последних пар реплик отдавать модели (по умолчанию 6)
# DIALOG_HISTORY_TURNS=6

# Ретраи при нестабильной сети (в telegram_bot.py)
# NETWORK_RETRY_ATTEMPTS=4
# NETWORK_RETRY_BASE_DELAY=2.0
# NETWORK_RETRY_MAX_DELAY=30

# OpenAI SDK: свои ретраи и таймаут (в pinecone_manager.py)
# OPENAI_MAX_RETRIES=5
# OPENAI_TIMEOUT=90

# Чанкинг документов (document_ingest.py)
# DOC_CHUNK_SIZE=1200
# DOC_CHUNK_OVERLAP=200
# DOC_MAX_CHUNKS=150

# Резюме ответов бота: максимальная длина символов (по умолчанию 300)
# ASSISTANT_SUMMARY_CHARS=300

# Консолидация памяти «как сон» (memory_consolidation.py)
# MEMORY_CONSOLIDATION_HOURS=24        # раз в сколько часов запускать
# MEMORY_CONSOLIDATION_DAYS=7         # записи старше этого возраста сжимаются в дайджест
# MEMORY_CONSOLIDATION_MIN_RECORDS=10 # минимум записей, чтобы запускать LLM-компрессию
